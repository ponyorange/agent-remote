{
  "name": "agent-remote-server-redis",
  "version": "0.1.0",
  "description": "Redis integration package for agent-remote server deployments.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "agent-remote-core": "workspace:*",
    "agent-remote-server-core": "workspace:*"
  },
  "peerDependencies": {
    "redis": ">=4.6.0"
  },
  "peerDependenciesMeta": {
    "redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "tsup": "^8.0.2",
    "typescript": "~5.4.5",
    "vitest": "^1.6.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agent-remote/agent-remote.git",
    "directory": "packages/server-redis"
  },
  "keywords": [
    "agent-remote",
    "ai-agent",
    "browser-tools",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  }
}
